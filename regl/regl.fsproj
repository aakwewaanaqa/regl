<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <Configurations>Release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <RootNamespace>Regl</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Dockerfile"/>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TextCopy" Version="6.2.1"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="src\CommandLine\Shared.fs"/>
        <!--Bash Command Types-->
        <Compile Include="src\CommandLine\Types\IFlag.fsi"/>
        <Compile Include="src\CommandLine\Types\IFlag.fs"/>
        <Compile Include="src\CommandLine\Types\IInFlag.fsi"/>
        <Compile Include="src\CommandLine\Types\IInFlag.fs"/>
        <Compile Include="src\CommandLine\Types\OnFlag.fs"/>
        <Compile Include="src\CommandLine\Types\InStringFlag.fs"/>
        <Compile Include="src\CommandLine\Types\ParseResult.fs"/>
        <Compile Include="src\CommandLine\Types\CommandBody.fs"/>
        <Compile Include="src\CommandLine\Builders\CommandBuilder.fs"/>
        <Compile Include="src\CommandLine\Types\Utility.fs" />
        <!--Gen Command Types-->
        <Compile Include="src\CommandLine\Commands\GenCommand\Types\*.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\Types\*.fs"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="src\CommandLine\IO\LinesBuffer.fs"/>
        <Compile Include="src\CommandLine\IO\InOut.fs"/>
    </ItemGroup>

    <ItemGroup>
        <!--Gen Commands-->
        <Compile Include="src\CommandLine\Commands\GenCommand\*.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\*.fs"/>
        <Content Include="src\CommandLine\Commands\GenCommand\README.md"/>
    </ItemGroup>

    <ItemGroup>
        <!--Bash Commands-->
        <Compile Include="src\CommandLine\Commands\*.fsi"/>
        <Compile Include="src\CommandLine\Commands\*.fs"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Program.fs"/>
    </ItemGroup>

</Project>
