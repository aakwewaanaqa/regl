<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <Configurations>Release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <RootNamespace>Regl</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Dockerfile"/>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FsToolkit.ErrorHandling" Version="5.0.0" />
        <PackageReference Include="TextCopy" Version="6.2.1"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="src\*.fs"/>
    </ItemGroup>

    <ItemGroup>
        <!--IO-->
        <Compile Include="src\CommandLine\IO\LinesBuffer.fs"/>
        <Compile Include="src\CommandLine\IO\InOut.fs"/>
        <!--IO-->

        <!--Types-->
        <!--Bash Command Types-->
        <Compile Include="src\CommandLine\Types\IParam.fsi"/>
        <Compile Include="src\CommandLine\Types\IParam.fs"/>
        <Compile Include="src\CommandLine\Types\Param.fs"/>

        <Compile Include="src\CommandLine\Types\FlagParseResult.fs"/>
        <Compile Include="src\CommandLine\Types\IFlag.fsi"/>
        <Compile Include="src\CommandLine\Types\IFlag.fs"/>
        <Compile Include="src\CommandLine\Types\OnFlag.fs"/>
        <Compile Include="src\CommandLine\Types\InStringFlag.fs"/>

        <Compile Include="src\CommandLine\Types\CommandParseResult.fs"/>
        <Compile Include="src\CommandLine\Types\CommandBody.fs"/>
        <Compile Include="src\CommandLine\Types\LineArgs.fs" />
        <Compile Include="src\CommandLine\Builders\CommandBuilder.fs"/>
        <!--Bash Command Types-->

        <!--Bash Commands of Gen Command Types-->
        <Compile Include="src\CommandLine\Commands\GenCommand\Types\*.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\Types\*.fs"/>
        <!--Bash Commands of Gen Command Types-->
        <!--Types-->

        <Compile Include="src\CommandLine\Validations\ArgValidation.fs" />

        <!--Shared Functions-->
        <Compile Include="src\CommandLine\Commands\Shared.fs"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\Shared.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\Shared.fs"/>
        <!--Shared Functions-->
    </ItemGroup>

    <ItemGroup>
        <!--Bash Commands-->
        <Compile Include="src\CommandLine\Commands\*.fsi"/>
        <Compile Include="src\CommandLine\Commands\*.fs"/>
        <!--Bash Commands-->

        <!--Bash Commands of Gen Command's Subcommands-->
        <Compile Include="src\CommandLine\Commands\GenCommand\AddEvcm.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\AddEvcm.fs"/>

        <Compile Include="src\CommandLine\Commands\GenCommand\Copy.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\Copy.fs"/>

        <Compile Include="src\CommandLine\Commands\GenCommand\Echo.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\Echo.fs"/>

        <Compile Include="src\CommandLine\Commands\GenCommand\SetEnvar.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\SetEnvar.fs"/>

        <Compile Include="src\CommandLine\Commands\GenCommand\UnsetEnvar.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\UnsetEnvar.fs"/>

        <Compile Include="src\CommandLine\Commands\GenCommand\Tpl.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\Tpl.fs"/>

        <Compile Include="src\CommandLine\Commands\GenCommand\Import.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\Import.fs"/>

        <Compile Include="src\CommandLine\Commands\GenCommand\Implementation.fsi"/>
        <Compile Include="src\CommandLine\Commands\GenCommand\Implementation.fs"/>
        <!--Bash Commands of Gen Command's Subcommands-->
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Program.fs"/>
    </ItemGroup>

</Project>
